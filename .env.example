# PostgreSQL connection string. On Vercel, attach a Postgres storage
# integration (Vercel Postgres / Neon) and it will provide this automatically.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Admin login for the content editor at /admin
ADMIN_USERNAME="esti"
# Generate with: node scripts/hash-password.js "your-password-here"
# IMPORTANT: escape every "$" in the generated hash as "\$" (Next.js expands
# bare $VAR patterns in .env files, which corrupts bcrypt hashes otherwise).
ADMIN_PASSWORD_HASH=""

# Random secret used to sign the admin session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# "Forgot password" emails, sent through Resend (https://resend.com).
# Without all of these the forgot-password button does nothing (errors are logged).
RESEND_API_KEY=""
# Where the reset link is sent.
ADMIN_RECOVERY_EMAIL=""
# Sender address. Optional — defaults to Resend's shared "onboarding@resend.dev",
# which can only deliver to the email you signed up to Resend with. Set this to
# an address on a domain verified in Resend to send to anyone.
RESEND_FROM_EMAIL=""

# Public site URL, used for canonical links, sitemap.xml, robots.txt and
# structured data. Optional — defaults to the current Vercel URL. Set this
# once a real domain is attached.
NEXT_PUBLIC_SITE_URL=""
