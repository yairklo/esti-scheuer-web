# PostgreSQL connection string. On Vercel, attach a Postgres storage
# integration (Vercel Postgres / Neon) and it will provide this automatically.
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Admin login for the content editor at /admin
ADMIN_USERNAME="esti"
# Generate with: node scripts/hash-password.js "your-password-here"
# IMPORTANT: escape every "$" in the generated hash as "\$" (Next.js expands
# bare $VAR patterns in .env files, which corrupts bcrypt hashes otherwise).
ADMIN_PASSWORD_HASH=""

# Random secret used to sign the admin session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# "Forgot password" emails, sent from a Gmail account over SMTP.
# Without all three the forgot-password button does nothing (errors are logged).
# The account needs 2-Step Verification; create the App Password at
# https://myaccount.google.com/apppasswords. Use a dedicated account, not a
# personal one: an App Password gives full access to that mailbox.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Where the reset link is sent (the site owner's own inbox).
ADMIN_RECOVERY_EMAIL=""

# Public site URL, used for canonical links, sitemap.xml, robots.txt and
# structured data. Optional — defaults to the current Vercel URL. Set this
# once a real domain is attached.
NEXT_PUBLIC_SITE_URL=""
