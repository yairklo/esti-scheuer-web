// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Singleton row (id is always 1) holding all editable site text as JSON.
model SiteContent {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}

// Singleton row (id is always 1) holding the admin login credentials, so the
// password can be changed at runtime from Settings without a redeploy.
model AdminAuth {
  id             Int      @id @default(1)
  username       String
  passwordHash   String
  // Embedded in session JWTs; bumped on every password change so sessions
  // issued before the change stop working.
  sessionVersion Int      @default(0)
  updatedAt      DateTime @updatedAt
}

// One-time links emailed from "forgot password". Only a SHA-256 of the token
// is stored, so a leaked DB row can't be turned back into a working link.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  // Requester's IP, for the per-IP rate limit.
  ip        String?
  createdAt DateTime  @default(now())
}

// One row per failed admin login, for the login rate limit. Rows older than
// the rate-limit window plus the lockout are deleted as new failures come in.
model FailedLogin {
  id        Int      @id @default(autoincrement())
  // Rate-limit bucket of the client's IP (IPv6 grouped by /64).
  ip        String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
